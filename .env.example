# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/satslots

# Lightning Backend: "lnd" (Polar/regtest) or "nwc" (Nostr Wallet Connect)
LIGHTNING_BACKEND=lnd

# LND (Polar) — uncomment and fill in for local development
LND_REST_URL=https://localhost:8087
LND_MACAROON=your_hex_encoded_admin_macaroon_here

# NWC (Alby Hub) — uncomment for production
# NWC_CONNECTION_STRING=nostr+walletconnect://...
